# ==========================================
# WORLD MONITOR - API Keys Template
# Copy to .env and fill in your keys
# Never commit .env to git!
# ==========================================

# ==========================================
# NEWS APIs (Free tiers available)
# ==========================================
NEWSAPI_KEY=your_newsapi_key_here
GNEWS_KEY=your_gnews_key_here

# ==========================================
# ENERGY APIs (Free with registration)
# ==========================================
EIA_KEY=your_eia_key_here

# ==========================================
# TRADE APIs (Free with registration)
# ==========================================
COMTRADE_KEY=your_comtrade_key_here

# ==========================================
# VESSEL TRACKING (Free tier)
# ==========================================
AISSTREAM_KEY=your_aisstream_key_here

# ==========================================
# COMMODITIES (Free tier - Alpha Vantage)
# ==========================================
ALPHA_KEY=your_alphavantage_key_here

# ==========================================
# WEBHOOK SECURITY
# ==========================================
WEBHOOK_SECRET=generate_a_random_string_here

# ==========================================
# CLOUDFLARE (for Worker deployment)
# ==========================================
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token
CF_KV_NAMESPACE_ID=your_kv_namespace_id