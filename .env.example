# WorldMonitor Environment Variables
# Copy to .env and fill in values
# NEVER commit .env to git!

# =============================================================================
# AI API Keys (Stored in 1Password/Bitwarden, injected at runtime)
# =============================================================================

# OpenAI (GPT-4, embeddings)
OPENAI_API_KEY=sk-...

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Google (Gemini)
GOOGLE_API_KEY=...

# Mistral
MISTRAL_API_KEY=...

# Cohere
COHERE_API_KEY=...

# =============================================================================
# News/Data APIs (Free tiers available)
# =============================================================================

# NewsAPI.org (free: 100 req/day)
NEWS_API_KEY=...

# GDELT (free, no key needed for basic)
# GDELT_API_KEY=...

# NewsCatcher (free tier)
NEWSCATCHER_API_KEY=...

# Mediastack (free: 100 req/month)
MEDIASTACK_API_KEY=...

# Aylien (free tier)
AYLIEN_APP_ID=...
AYLIEN_API_KEY=...

# =============================================================================
# Specialized Energy/Trade APIs
# =============================================================================

# EIA (US Energy Info Admin) - free
EIA_API_KEY=...

# Platts/Argus/ICIS - paid, enterprise
# PLATTS_API_KEY=...

# WITS (World Integrated Trade Solution) - free
# WITS_API_KEY=...

# UN Comtrade - free tier
# UNCOMTRADE_API_KEY=...

# Panjiva (import/export) - paid
# PANJIVA_API_KEY=...

# =============================================================================
# Database (if using Docker Compose)
# =============================================================================

POSTGRES_PASSWORD=worldmonitor_dev
DATABASE_URL=postgresql://worldmonitor:worldmonitor_dev@localhost:5432/worldmonitor

# Redis (if using)
REDIS_URL=redis://localhost:6379

# =============================================================================
# Cloudflare Tunnel
# =============================================================================

# Get from: cloudflared tunnel token worldmonitor-dev
CLOUDFLARE_TUNNEL_TOKEN=...

# =============================================================================
# Vercel (for preview deploys)
# =============================================================================

VERCEL_TOKEN=...
VERCEL_ORG_ID=...
VERCEL_PROJECT_ID=...

# =============================================================================
# GitHub (for Codespaces, Actions)
# =============================================================================

GITHUB_TOKEN=ghp_...

# =============================================================================
# Application Config
# =============================================================================

NODE_ENV=development
PORT=3000
MCP_HTTP_PORT=3001
RUFLO_API_PORT=3002

# Logging
LOG_LEVEL=debug

# Feature flags
ENABLE_SWARM=true
ENABLE_MCP=true
ENABLE_HOOKS=true