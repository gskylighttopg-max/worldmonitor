# =============================================================================
# WorldMonitor - Git Ignore Rules
# =============================================================================

# Ruflo local secrets and runtime data
.env
.env.local
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/

# Cloudflare Tunnel credentials (each developer has their own)
.cloudflared/*.json
.cloudflared/*.pem
.cloudflared/cert.pem
*.tunnel.yml

# 1Password/Bitwarden
.op/
.bitwarden/

# Node.js dependencies
node_modules/
.pnpm-store/
.pnpm-lock.yaml

# Build outputs
dist/
build/
.next/
out/
*.tsbuildinfo

# IDE/Editor
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage
coverage/
.nyc_output/

# Docker
.docker/

# Vercel
.vercel

# Turbo
.turbo

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Ruflo specific
.swarm/
.mcp.json.local

# Secrets (never commit!)
*.key
*.pem
*.crt
*.p12
*.pfx
secrets/
credentials/

# =============================================================================
# ALLOWED (committed to repo)
# =============================================================================
# .cloudflared/config.yml (template, no credentials)
# .devcontainer/ (full config)
# scripts/ (all scripts)
# docker-compose.yml
# .env.example
# TEAM_ONBOARDING.md
# COLLABORATION_SETUP.md
# .vscode/ (settings, tasks, launch, extensions)